<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Native AOT runtime validation of the SDK's source-generated JSON (de)serialization, including
         the schema 1.6.0 fields. PublishAot only takes effect at publish time: the CI "aot" job
         publishes this project for linux-x64 and runs the native binary; ordinary solution builds
         stay plain managed builds. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Floor the AOT runtime pack + ILCompiler at 10.0.14, the patched release for CVE-2026-111497
         (Brotli decoder out-of-bounds write, GHSA-p3jp-9v83-76w9). The decoder is linked into the
         native binary, so an older SDK's bundled 10.0.x must not be used to publish this app. -->
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetRiskScan\NetRiskScan.csproj" />
  </ItemGroup>

</Project>