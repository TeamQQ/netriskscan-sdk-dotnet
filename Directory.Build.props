<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- A nullable-annotation mistake on a tri-state flag or the risk index is exactly the class of bug
         this SDK exists to avoid (see README "Nullable and tri-state semantics"), so it fails the
         build here, matching the main NetRiskScan repository's own Directory.Build.props. -->
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Authors>NetRiskScan</Authors>
    <Company>NetRiskScan</Company>
    <Copyright>Copyright (c) 2026 NetRiskScan</Copyright>
    <PackageProjectUrl>https://www.netriskscan.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TeamQQ/netriskscan-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Reproducible builds: only stamped when running in CI (see ci.yml / publish.yml). -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
